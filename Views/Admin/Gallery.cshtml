@model IEnumerable<AdharshaHighSchool.Models.Gallery>

@{
    ViewBag.Title = "Gallery";
}

<style>

    body {
        background: #f5f7fb;
    }

    .gallery-page {
        padding: 25px 0 40px;
        min-height: 75vh;
    }

    /* HEADER */
    .gallery-header {
        background: linear-gradient(135deg, #8b5cf6, #6d28d9);
        color: white;
        padding: 25px 28px;
        border-radius: 16px;
        margin-bottom: 25px;
        box-shadow: 0 8px 25px rgba(109, 40, 217, 0.18);
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .header-title h2 {
        margin: 0;
        font-weight: 700;
        font-size: 28px;
    }

    .header-title p {
        margin: 7px 0 0;
        opacity: 0.9;
    }

    .header-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-dashboard {
        background: rgba(255,255,255,0.18);
        color: white;
        border: 1px solid rgba(255,255,255,0.35);
        padding: 10px 16px;
        border-radius: 9px;
        text-decoration: none;
        font-weight: 500;
    }

        .btn-dashboard:hover {
            background: white;
            color: #6d28d9;
            text-decoration: none;
        }

    .btn-add {
        background: white;
        color: #6d28d9;
        border: none;
        padding: 10px 17px;
        border-radius: 9px;
        text-decoration: none;
        font-weight: 600;
    }

        .btn-add:hover {
            background: #f5f3ff;
            color: #5b21b6;
            text-decoration: none;
        }


    /* SUMMARY */
    .summary-box {
        background: white;
        border-radius: 14px;
        padding: 18px 22px;
        margin-bottom: 25px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.05);
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .summary-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #ede9fe;
        color: #7c3aed;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .summary-text strong {
        display: block;
        font-size: 22px;
        color: #1f2937;
    }

    .summary-text span {
        color: #6b7280;
        font-size: 14px;
    }


    /* GALLERY CARD */
    .gallery-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        height: 100%;
        box-shadow: 0 5px 20px rgba(0,0,0,0.06);
        border: 1px solid #f0f0f0;
        transition: all 0.25s ease;
    }

        .gallery-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.10);
        }


    /* IMAGE */
    .gallery-image {
        width: 100%;
        height: 210px;
        object-fit: cover;
        background: #f3f4f6;
        display: block;
    }

    .no-image {
        width: 100%;
        height: 210px;
        background: linear-gradient(135deg, #f5f3ff, #ede9fe);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 60px;
    }


    /* BODY */
    .gallery-body {
        padding: 20px;
    }

    .gallery-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 10px;
    }

    .gallery-title {
        margin: 0;
        font-size: 19px;
        font-weight: 700;
        color: #1f2937;
    }

    .gallery-description {
        color: #6b7280;
        line-height: 1.6;
        min-height: 50px;
        margin-bottom: 12px;
    }


    /* STATUS */
    .status-active {
        background: #dcfce7;
        color: #15803d;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-inactive {
        background: #fee2e2;
        color: #b91c1c;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }


    /* DATE */
    .gallery-date {
        display: inline-block;
        background: #f9fafb;
        color: #6b7280;
        border-radius: 7px;
        padding: 6px 9px;
        font-size: 12px;
    }


    /* ACTIONS */
    .gallery-actions {
        margin-top: 16px;
        padding-top: 15px;
        border-top: 1px solid #f1f5f9;
        display: flex;
        gap: 8px;
    }

    .btn-edit {
        flex: 1;
        border: 1px solid #2563eb;
        color: #2563eb;
        background: white;
        padding: 8px 12px;
        border-radius: 8px;
        text-align: center;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }

        .btn-edit:hover {
            background: #2563eb;
            color: white;
            text-decoration: none;
        }

    .btn-delete {
        flex: 1;
        border: 1px solid #dc2626;
        color: #dc2626;
        background: white;
        padding: 8px 12px;
        border-radius: 8px;
        text-align: center;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }

        .btn-delete:hover {
            background: #dc2626;
            color: white;
            text-decoration: none;
        }


    /* EMPTY */
    .empty-box {
        background: white;
        border-radius: 16px;
        padding: 60px 20px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    }

    .empty-icon {
        font-size: 60px;
        margin-bottom: 15px;
    }

    .empty-box h4 {
        color: #1f2937;
        font-weight: 700;
    }

    .empty-box p {
        color: #6b7280;
        margin-bottom: 20px;
    }


    /* RESPONSIVE */
    @@media (max-width: 768px) {

        .gallery-page {
            padding: 15px 0 30px;
        }

        .gallery-header {
            padding: 20px;
        }

        .header-content {
            flex-direction: column;
            align-items: flex-start;
        }

        .header-buttons {
            width: 100%;
        }

        .gallery-image,
        .no-image {
            height: 190px;
        }
    }
</style>


<div class="gallery-page">

    <div class="container">

        <!-- HEADER -->

        <div class="gallery-header">

            <div class="header-content">

                <div class="header-title">

                    <h2>🖼️ Gallery</h2>

                    <p>
                        Manage your school's photos and gallery.
                    </p>

                </div>

                <div class="header-buttons">

                    <a href="@Url.Action("Dashboard", "Admin")"
                       class="btn-dashboard">
                        ← Dashboard
                    </a>

                    <a href="@Url.Action("AddGallery", "Admin")"
                       class="btn-add">
                        + Add Gallery
                    </a>

                </div>

            </div>

        </div>


        <!-- SUMMARY -->

        <div class="summary-box">

            <div class="summary-icon">
                🖼️
            </div>

            <div class="summary-text">

                <strong>
                    @(Model == null ? 0 : Model.Count())
                </strong>

                <span>
                    Total Gallery Images
                </span>

            </div>

        </div>


        <!-- GALLERY -->

        @if (Model != null && Model.Any())
        {
            <div class="row">

                @foreach (var item in Model)
                {
                    <div class="col-lg-4 col-md-6 mb-4">

                        <div class="gallery-card">


                            <!-- IMAGE -->

                            @if (!string.IsNullOrEmpty(item.Image))
                            {
                                <img src="@Url.Content(item.Image)"
                                     class="gallery-image"
                                     alt="@item.Title" />
                            }
                            else
                            {
                                <div class="no-image">
                                    🖼️
                                </div>
                            }


                            <!-- BODY -->

                            <div class="gallery-body">

                                <div class="gallery-top">

                                    <h4 class="gallery-title">
                                        @item.Title
                                    </h4>

                                    @if (item.IsActive)
                                    {
                                        <span class="status-active">
                                            ACTIVE
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-inactive">
                                            INACTIVE
                                        </span>
                                    }

                                </div>


                                <p class="gallery-description">

                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        @item.Description
                                    }
                                    else
                                    {
                                        <span>No description available.</span>
                                    }

                                </p>


                                <span class="gallery-date">

                                    📅 Added:
                                    @item.CreatedDate.ToString("dd-MM-yyyy")

                                </span>


                                <!-- ACTIONS -->

                                <div class="gallery-actions">

                                    <a href="@Url.Action("EditGallery", "Admin", new { id = item.GalleryId })"
                                       class="btn-edit">
                                        ✏️ Edit
                                    </a>

                                    <a href="@Url.Action("DeleteGallery", "Admin", new { id = item.GalleryId })"
                                       class="btn-delete"
                                       onclick="return confirm('Are you sure you want to delete this gallery item?');">
                                        🗑️ Delete
                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <!-- EMPTY STATE -->

            <div class="empty-box">

                <div class="empty-icon">
                    🖼️
                </div>

                <h4>
                    No Gallery Images
                </h4>

                <p>
                    No gallery information has been added yet.
                </p>

                <a href="@Url.Action("AddGallery", "Admin")"
                   class="btn-add">
                    + Add Gallery
                </a>

            </div>
        }

    </div>

</div>