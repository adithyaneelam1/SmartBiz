@model AdharshaHighSchool.Models.ContactMessage

@{
    ViewBag.Title = "View Message";
}

<style>

    .message-header {
        background: linear-gradient(135deg, #06b6d4, #0e7490);
        color: white;
        padding: 25px;
        border-radius: 15px 15px 0 0;
    }

    .message-body {
        background: white;
        padding: 30px;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .detail-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 5px;
    }

    .detail-value {
        color: #4b5563;
        margin-bottom: 20px;
    }

    .full-message {
        background: #f9fafb;
        padding: 20px;
        border-radius: 10px;
        white-space: pre-line;
        color: #374151;
        line-height: 1.7;
    }
</style>


<div class="mb-4">

    <a href="@Url.Action("Messages", "Admin")"
       class="btn btn-outline-secondary">

        ← Back to Messages

    </a>

</div>


<div class="message-header">

    <h2 class="mb-1">
        📩 View Message
    </h2>

    <p class="mb-0">
        Complete message details from the website visitor.
    </p>

</div>


<div class="message-body">

    <div class="row">

        <div class="col-md-6">

            <div class="detail-label">
                Name
            </div>

            <div class="detail-value">
                @Model.Name
            </div>

        </div>


        <div class="col-md-6">

            <div class="detail-label">
                Email
            </div>

            <div class="detail-value">
                @Model.Email
            </div>

        </div>


        <div class="col-md-6">

            <div class="detail-label">
                Mobile
            </div>

            <div class="detail-value">
                @Model.Mobile
            </div>

        </div>


        <div class="col-md-6">

            <div class="detail-label">
                Date
            </div>

            <div class="detail-value">

                @Model.CreatedDate.ToString("dd-MM-yyyy hh:mm tt")

            </div>

        </div>

    </div>


    <hr />


    <div class="detail-label">
        Message
    </div>

    <div class="full-message">
        @Model.Message
    </div>


    <div class="mt-4">

        @if (!Model.IsRead)
        {
            <a href="@Url.Action("MarkMessageAsRead", "Admin", new { id = Model.MessageId })"
               class="btn btn-success">

                ✓ Mark as Read

            </a>
        }


        <a href="@Url.Action("DeleteMessage", "Admin", new { id = Model.MessageId })"
           class="btn btn-outline-danger"
           onclick="return confirm('Are you sure you want to delete this message?');">

            🗑️ Delete

        </a>

        <a href="@Url.Action("Messages", "Admin")"
           class="btn btn-outline-secondary">

            Back

        </a>

    </div>

</div>
