@model AdharshaHighSchool.Models.Facility

@{
    ViewBag.Title = "Add Facility";
}

<style>

    .form-header {
        background: linear-gradient(135deg, #f97316, #ea580c);
        color: white;
        padding: 25px;
        border-radius: 15px 15px 0 0;
    }

    .form-body {
        background: white;
        padding: 30px;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .form-label {
        font-weight: 600;
        color: #374151;
    }

    .image-help {
        font-size: 13px;
        color: #6b7280;
        margin-top: 6px;
    }
</style>


<div class="mb-4">

    <a href="@Url.Action("Facilities", "Admin")"
       class="btn btn-outline-secondary">
        ← Back to Facilities
    </a>

</div>


<div class="form-header">

    <h2 class="mb-1">
        🏫 Add Facility
    </h2>

    <p class="mb-0">
        Add a new school facility.
    </p>

</div>


<div class="form-body">

    @using (Html.BeginForm(
        "AddFacility",
        "Admin",
        FormMethod.Post,
        new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()


        <!-- FACILITY NAME -->

        <div class="mb-4">

            <label class="form-label">
                Facility Name
            </label>

            @Html.TextBoxFor(
                x => x.FacilityName,
                new
                {
                    @class = "form-control",
                    placeholder = "Example: Computer Lab"
                })

            @Html.ValidationMessageFor(
                x => x.FacilityName,
                "",
                new { @class = "text-danger" })

        </div>


        <!-- DESCRIPTION -->

        <div class="mb-4">

            <label class="form-label">
                Description
            </label>

            @Html.TextAreaFor(
                x => x.Description,
                new
                {
                    @class = "form-control",
                    rows = 5,
                    placeholder = "Enter facility description"
                })

        </div>


        <!-- IMAGE UPLOAD -->

        <div class="mb-4">

            <label class="form-label">
                Facility Image
            </label>

            <input type="file"
                   name="ImageFile"
                   id="ImageFile"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.gif,.webp" />

            <div class="image-help">
                Allowed formats: JPG, JPEG, PNG, GIF and WEBP.
            </div>

            @Html.ValidationMessage(
                "ImageFile",
                "",
                new { @class = "text-danger" })

        </div>


        <!-- DISPLAY ORDER + STATUS -->

        <div class="row">

            <div class="col-md-6 mb-4">

                <label class="form-label">
                    Display Order
                </label>

                @Html.TextBoxFor(
                    x => x.DisplayOrder,
                    new
                    {
                        @class = "form-control",
                        type = "number"
                    })

            </div>


            <div class="col-md-6 mb-4">

                <label class="form-label">
                    Status
                </label>

                <div class="form-check form-switch mt-2">

                    @Html.CheckBoxFor(
                        x => x.IsActive,
                        new
                        {
                            @class = "form-check-input"
                        })

                    <label class="form-check-label">
                        Active
                    </label>

                </div>

            </div>

        </div>


        <!-- BUTTONS -->

        <div class="mt-3">

            <button type="submit"
                    class="btn btn-primary">
                💾 Save Facility
            </button>

            <a href="@Url.Action("Facilities", "Admin")"
               class="btn btn-outline-secondary ms-2">
                Cancel
            </a>

        </div>

    }

</div>