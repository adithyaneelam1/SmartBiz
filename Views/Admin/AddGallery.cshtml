@model AdharshaHighSchool.Models.Gallery

@{
    ViewBag.Title = "Add Gallery";
}

<style>

    .form-header {
        background: linear-gradient(135deg, #8b5cf6, #6d28d9);
        color: white;
        padding: 25px;
        border-radius: 15px 15px 0 0;
    }

    .form-body {
        background: white;
        padding: 30px;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .form-label {
        font-weight: 600;
        color: #374151;
    }
</style>


<div class="mb-4">

    <a href="@Url.Action("Gallery", "Admin")"
       class="btn btn-outline-secondary">
        ← Back to Gallery
    </a>

</div>


<div class="form-header">

    <h2 class="mb-1">
        🖼️ Add Gallery
    </h2>

    <p class="mb-0">
        Add a new school photo to the gallery.
    </p>

</div>


<div class="form-body">

   
    @using (Html.BeginForm(
        "AddGallery",
        "Admin",
        FormMethod.Post,
        new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <div class="mb-4">

            <label class="form-label">
                Gallery Title
            </label>

            @Html.TextBoxFor(
                x => x.Title,
                new
                {
                    @class = "form-control",
                    placeholder = "Example: School Annual Day"
                })

        </div>


        <div class="mb-4">

            <label class="form-label">
                Select Gallery Image
            </label>

            <input type="file"
                   name="ImageFile"
                   id="ImageFile"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.gif,.webp" />

            @Html.ValidationMessage(
                "ImageFile",
                "",
                new { @class = "text-danger" })

            <small class="text-muted">
                Allowed formats: JPG, JPEG, PNG, GIF, WEBP
            </small>

        </div>


        <div class="mb-4">

            <label class="form-label">
                Description
            </label>

            @Html.TextAreaFor(
                x => x.Description,
                new
                {
                    @class = "form-control",
                    rows = 5,
                    placeholder = "Enter photo description"
                })

        </div>


        <div class="mb-4">

            <label class="form-label">
                Status
            </label>

            <div class="form-check form-switch mt-2">

                @Html.CheckBoxFor(
                    x => x.IsActive,
                    new { @class = "form-check-input" })

                <label class="form-check-label">
                    Active
                </label>

            </div>

        </div>


        <div class="mt-3">

            <button type="submit"
                    class="btn btn-primary">
                💾 Save Gallery
            </button>

            <a href="@Url.Action("Gallery", "Admin")"
               class="btn btn-outline-secondary ms-2">
                Cancel
            </a>

        </div>

    }

</div>