@model AdharshaHighSchool.Models.Gallery

@{
    ViewBag.Title = "Edit Gallery";
}

<style>

    .form-header {
        background: linear-gradient(135deg, #0ea5e9, #0369a1);
        color: white;
        padding: 25px;
        border-radius: 15px 15px 0 0;
    }

    .form-body {
        background: white;
        padding: 30px;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .form-label {
        font-weight: 600;
        color: #374151;
    }

    .current-image {
        width: 220px;
        height: 150px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #ddd;
        margin-top: 10px;
    }
</style>


<div class="mb-4">

    <a href="@Url.Action("Gallery", "Admin")"
       class="btn btn-outline-secondary">

        ← Back to Gallery

    </a>

</div>


<div class="form-header">

    <h2 class="mb-1">
        ✏️ Edit Gallery
    </h2>

    <p class="mb-0">
        Update gallery information.
    </p>

</div>


<div class="form-body">

    @using (Html.BeginForm(
        "EditGallery",
        "Admin",
        FormMethod.Post,
        new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(x => x.GalleryId)


        <!-- Gallery Title -->

        <div class="mb-4">

            <label class="form-label">
                Gallery Title
            </label>

            @Html.TextBoxFor(
                x => x.Title,
                new
                {
                    @class = "form-control",
                    placeholder = "Enter gallery title"
                })

        </div>


        <!-- Current Image -->

        <div class="mb-4">

            <label class="form-label">
                Current Image
            </label>

            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <div>

                    <img src="@Url.Content(Model.Image)"
                         class="current-image"
                         alt="@Model.Title" />

                </div>
            }

        </div>


        <!-- New Image -->

        <div class="mb-4">

            <label class="form-label">
                Replace Image
            </label>

            <input type="file"
                   name="ImageFile"
                   id="ImageFile"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.gif,.webp" />

            <small class="text-muted">
                Leave empty if you don't want to change the current image.
            </small>

            @Html.ValidationMessage(
                "ImageFile",
                "",
                new { @class = "text-danger" })

        </div>


        <!-- Description -->

        <div class="mb-4">

            <label class="form-label">
                Description
            </label>

            @Html.TextAreaFor(
                x => x.Description,
                new
                {
                    @class = "form-control",
                    rows = 5,
                    placeholder = "Enter photo description"
                })

        </div>


        <!-- Status -->

        <div class="mb-4">

            <label class="form-label">
                Status
            </label>

            <div class="form-check form-switch mt-2">

                @Html.CheckBoxFor(
                    x => x.IsActive,
                    new { @class = "form-check-input" })

                <label class="form-check-label">
                    Active
                </label>

            </div>

        </div>


        <!-- Buttons -->

        <div class="mt-3">

            <button type="submit"
                    class="btn btn-primary">

                💾 Update Gallery

            </button>

            <a href="@Url.Action("Gallery", "Admin")"
               class="btn btn-outline-secondary ms-2">

                Cancel

            </a>

        </div>

    }

</div>