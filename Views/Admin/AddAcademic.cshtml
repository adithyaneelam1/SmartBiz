@model AdharshaHighSchool.Models.Academic

@{
    ViewBag.Title = "Add Academic";
}

<style>

    .academic-form-page {
        background: #f5f7fb;
        min-height: 75vh;
        padding: 30px 0;
    }

    .academic-form-card {
        background: #ffffff;
        border-radius: 15px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.07);
        overflow: hidden;
    }

    .academic-form-header {
        background: linear-gradient(135deg, #2563eb, #38bdf8);
        color: white;
        padding: 25px 30px;
    }

        .academic-form-header h2 {
            margin: 0;
            font-weight: 600;
        }

        .academic-form-header p {
            margin: 7px 0 0;
            opacity: 0.9;
        }

    .academic-form-body {
        padding: 30px;
    }

    .form-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 8px;
    }

    .form-control {
        border-radius: 9px;
        border: 1px solid #d1d5db;
        padding: 11px 13px;
    }

        .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37,99,235,0.12);
        }

    .description-box {
        min-height: 130px;
        resize: vertical;
    }

    .order-box {
        max-width: 180px;
    }

    .active-box {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 9px;
        padding: 12px 15px;
    }

    .btn-save {
        background: #2563eb;
        border: none;
        color: white;
        padding: 11px 24px;
        border-radius: 8px;
        font-weight: 500;
    }

        .btn-save:hover {
            background: #1d4ed8;
            color: white;
        }

    .btn-cancel {
        background: #f3f4f6;
        border: 1px solid #d1d5db;
        color: #374151;
        padding: 11px 24px;
        border-radius: 8px;
        text-decoration: none;
        margin-left: 8px;
    }

        .btn-cancel:hover {
            background: #e5e7eb;
            color: #111827;
            text-decoration: none;
        }
</style>


<div class="academic-form-page">

    <div class="container">

        <div class="academic-form-card">

            <!-- HEADER -->

            <div class="academic-form-header">

                <h2>📚 Add Academic Information</h2>

                <p>
                    Add academic programs and educational information
                    for your school website.
                </p>

            </div>


            <!-- FORM -->

            <div class="academic-form-body">

                @using (Html.BeginForm(
                    "AddAcademic",
                    "Admin",
                    FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <!-- TITLE -->

                    <div class="mb-4">

                        <label class="form-label">
                            Academic Title
                        </label>

                        @Html.TextBoxFor(
                            x => x.Title,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Example: Primary Education"
                            })

                    </div>


                    <!-- DESCRIPTION -->

                    <div class="mb-4">

                        <label class="form-label">
                            Description
                        </label>

                        @Html.TextAreaFor(
                            x => x.Description,
                            new
                            {
                                @class = "form-control description-box",
                                placeholder = "Enter academic information..."
                            })

                    </div>


                    <div class="row">

                        <!-- DISPLAY ORDER -->

                        <div class="col-md-6 mb-4">

                            <label class="form-label">
                                Display Order
                            </label>

                            @Html.TextBoxFor(
                                x => x.DisplayOrder,
                                new
                                {
                                    @class = "form-control order-box",
                                    type = "number",
                                    min = "0"
                                })

                            <small class="text-muted">
                                Lower numbers will appear first.
                            </small>

                        </div>


                        <!-- ACTIVE -->

                        <div class="col-md-6 mb-4">

                            <label class="form-label">
                                Status
                            </label>

                            <div class="active-box">

                                <label>

                                    @Html.CheckBoxFor(
                                        x => x.IsActive)

                                    &nbsp; Active

                                </label>

                            </div>

                        </div>

                    </div>


                    <!-- BUTTONS -->

                    <div class="mt-3">

                        <button type="submit"
                                class="btn-save">

                            💾 Save Academic

                        </button>


                        <a href="@Url.Action("Academics", "Admin")"
                           class="btn-cancel">

                            ← Back to Academics

                        </a>

                    </div>

                }

            </div>

        </div>

    </div>

</div>
