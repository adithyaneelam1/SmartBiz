@model IEnumerable<SunnyPractice.Models.EMP3>

<h2>Employee List</h2>


@*ADD EMPLOYEE*@


<a href="@Url.Action("Emp", "Emp3")"
   class="btn btn-success">

    Add Employee

</a>

<br />
<br />

@*EMPLOYEE TABLE*@


<table class="table table-bordered">

    <thead>

        <tr>

            <th>Eid</th>

            <th>Ename</th>

            <th>Salary</th>

            <th>Action</th>

        </tr>

    </thead>


    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @item.Eid
                </td>

                <td>
                    @item.Ename
                </td>

                <td>
                    @item.salary
                </td>

                <td>



                    @*EDIT*@


                    <button type="button"
                            class="btn btn-primary btn-sm"
                            onclick="editEmployee(@item.Eid)">

                        Edit

                    </button>


                    @*DELETE*@


                    <button type="button"
                            class="btn btn-danger btn-sm"
                            onclick="deleteEmployee(@item.Eid)">

                        Delete

                    </button>

                </td>

            </tr>
        }

    </tbody>

</table>


<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


<script>

    
    //EDIT EMPLOYEE
   
    function editEmployee(Eid) {

        $.ajax({

            url: '@Url.Action("GetEmp", "Emp3")',

            type: "GET",

            data: {

                Eid: Eid

            },

            success: function (data) {

                if (data.success) {

                    window.location.href =
                        '@Url.Action("Emp", "Emp3")'
                        + '?Eid='
                        + Eid;

                }
                else {

                    alert(data.message);

                }

            },

            error: function () {

                alert("Error loading employee.");

            }

        });

    }


   
    // DELETE EMPLOYEE
  

    function deleteEmployee(Eid) {


        // Confirmation popup

        if (!confirm(
            "Do you want to delete this employee?"
        )) {

            return;

        }


      
        // AJAX DELETE


        $.ajax({

            url: '@Url.Action("Delete", "Emp3")',

            type: "POST",

            data: {

                Eid: Eid

            },

            success: function (data) {

                if (data.success) {

                    alert("Employee deleted successfully!");

                    location.reload();

                }
                else {

                    alert(data.message);

                }

            },

            error: function () {

                alert("Error deleting employee.");

            }

        });

    }

</script>



























