@model AdharshaHighSchool.Models.ContactViewModel

@{
    Layout = "~/Views/Shared/_SchoolLayout.cshtml";
    ViewBag.Title = "Contact Us";

    var school = ViewBag.School
        as AdharshaHighSchool.Models.SchoolInfo;
}

<style>
    .contact-hero {
        background: linear-gradient(135deg, #0f766e, #14b8a6);
        color: white;
        padding: 70px 20px;
        text-align: center;
    }

        .contact-hero h1 {
            font-size: 44px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .contact-hero p {
            font-size: 18px;
            margin: 0;
        }

    .contact-section {
        padding: 60px 20px;
        background: #f8fafc;
    }

    .contact-card {
        background: white;
        border-radius: 18px;
        padding: 30px;
        height: 100%;
        box-shadow: 0 5px 25px rgba(0,0,0,0.08);
    }

        .contact-card h3 {
            color: #0f766e;
            font-weight: 700;
            margin-bottom: 25px;
        }

    .contact-info {
        margin-bottom: 22px;
    }

    .contact-icon {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: #ccfbf1;
        color: #0f766e;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        margin-bottom: 8px;
    }

    .contact-info strong {
        display: block;
        color: #1f2937;
        margin-bottom: 4px;
    }

    .contact-info span {
        color: #6b7280;
    }

    .form-label {
        font-weight: 600;
        color: #374151;
    }

    .form-control {
        border-radius: 10px;
        padding: 12px 15px;
        border: 1px solid #d1d5db;
    }

        .form-control:focus {
            border-color: #14b8a6;
            box-shadow: 0 0 0 3px rgba(20,184,166,0.15);
        }

    .btn-send {
        background: #0f766e;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 12px 30px;
        font-weight: 600;
    }

        .btn-send:hover {
            background: #115e59;
            color: white;
        }

    .success-message {
        background: #dcfce7;
        color: #166534;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .validation-message {
        color: #dc2626;
        font-size: 14px;
    }
</style>


<!-- HERO -->
<section class="contact-hero">

    <h1>📞 Contact Us</h1>

    <p>
        We would be happy to hear from you.
    </p>

</section>


<!-- CONTACT SECTION -->
<section class="contact-section">

    <div class="container">

        <div class="row g-4">

            <!-- SCHOOL INFORMATION -->
            <div class="col-lg-5">

                <div class="contact-card">

                    <h3>
                        🏫 School Information
                    </h3>

                    @if (school != null)
                    {
                        <div class="contact-info">

                            <div class="contact-icon">
                                📍
                            </div>

                            <strong>Address</strong>

                            <span>
                                @school.Address
                            </span>

                        </div>


                        <div class="contact-info">

                            <div class="contact-icon">
                                📞
                            </div>

                            <strong>Phone</strong>

                            <span>
                                @school.Phone
                            </span>

                        </div>


                        <div class="contact-info">

                            <div class="contact-icon">
                                ✉️
                            </div>

                            <strong>Email</strong>

                            <span>
                                @school.Email
                            </span>

                        </div>


                        <div class="contact-info">

                            <div class="contact-icon">
                                👨‍🏫
                            </div>

                            <strong>Principal</strong>

                            <span>
                                @school.PrincipalName
                            </span>

                        </div>
                    }

                </div>

            </div>


            <!-- CONTACT FORM -->
            <div class="col-lg-7">

                <div class="contact-card">

                    <h3>
                        ✉️ Send Us a Message
                    </h3>

                    @if (ViewBag.SuccessMessage != null)
                    {
                        <div class="success-message">
                            @ViewBag.SuccessMessage
                        </div>
                    }

                    @using (Html.BeginForm("Contact", "School",
                                           FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                @Html.LabelFor(
                                    model => model.Name,
                                    new { @class = "form-label" })

                                @Html.TextBoxFor(
                                    model => model.Name,
                                    new
                                    {
                                        @class = "form-control",
                                        placeholder = "Enter your name"
                                    })

                                @Html.ValidationMessageFor(
                                    model => model.Name,
                                    "",
                                    new { @class = "validation-message" })

                            </div>


                            <div class="col-md-6 mb-3">

                                @Html.LabelFor(
                                    model => model.Email,
                                    new { @class = "form-label" })

                                @Html.TextBoxFor(
                                    model => model.Email,
                                    new
                                    {
                                        @class = "form-control",
                                        placeholder = "Enter your email"
                                    })

                                @Html.ValidationMessageFor(
                                    model => model.Email,
                                    "",
                                    new { @class = "validation-message" })

                            </div>

                        </div>


                        <div class="mb-3">

                            @Html.LabelFor(
                                model => model.Mobile,
                                new { @class = "form-label" })

                            @Html.TextBoxFor(
                                model => model.Mobile,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Enter your mobile number"
                                })

                        </div>


                        <div class="mb-3">

                            @Html.LabelFor(
                                model => model.Message,
                                new { @class = "form-label" })

                            @Html.TextAreaFor(
                                model => model.Message,
                                5,
                                0,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Enter your message"
                                })

                            @Html.ValidationMessageFor(
                                model => model.Message,
                                "",
                                new { @class = "validation-message" })

                        </div>


                        <button type="submit"
                                class="btn btn-send">

                            📩 Send Message

                        </button>
                    }

                </div>

            </div>

        </div>

    </div>

</section>
