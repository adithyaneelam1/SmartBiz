@{
    ViewBag.Title = "Contact";
}
<h3>LIST OF PATIENENT</h3>

<p> TIME:@DateTime.Now </p>

<form action="/Home/contact" method="post">
    <br />

    <label>ID:@ViewBag.Id</label>



    <input type="hidden" name="id" id="id" value="@ViewBag.Id"><br /><br />

    <label>name:</label>
    <input type="text" id="name" name="name" placeholder="enter your name" value="@ViewBag.name" /><br /><br />

    <label> AGE:</label>
    <input type="number" id="age" name="age" min="1" max="100" value="@ViewBag.age" /><br /><br />
    <label> Gender:</label><br>
    <input type="radio" name="Gender" value="male" @(ViewBag.gender?.ToString() == "male" ? "checked" : "") />male<br />
    <input type="radio" name="Gender" value="female" @(ViewBag.gender?.ToString() == "female" ? "checked" : "") />female<br />
    <br />
    <label>Disease:</label><br />
    <input type="text" id="disease" name="disease" value="@ViewBag.disease" /><br /><br />




    @*<h2> Select option:</h2>

        <input type="radio"  name="delete" value="delete" /><br />

        <label> delete:</label>

        <input type="radio" name="insert" value="insert" />

        <label>insert:</label> <br />*@

    @*<button type="submit">Save</button>*@

    <input type="submit" value="SUBMIT" class="btn btn-primary" /><br />


</form>
<br />
<a href="/home/Registration" class="btn btn-danger">back to list</a>


<br /> <p style="color:red">
    @ViewBag.msg
</p>

